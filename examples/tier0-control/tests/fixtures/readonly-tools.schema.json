    {
      "name": "read_image",
      "description": "Resolve an image_ref against registered persisted observation history, read via Tier0 API key and verify SHA256. Returns original image bytes; no host file or arbitrary URL access.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable registered device ID from list_devices"
          },
          "image_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "device_id",
          "image_ref"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string"
          },
          "read_only": {
            "type": "boolean"
          }
        },
        "required": [
          "api_version",
          "read_only"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "query_action_results",
      "description": "Find action requests by device and ingestion interval, then fetch result evidence beyond that interval. Accepted is not verified; missing proof is unknown after deadline. Evaluation uses an explicit numeric-target policy.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable registered device ID from list_devices"
          },
          "start_time": {
            "type": "string",
            "minLength": 1,
            "description": "RFC3339 time with explicit UTC offset, e.g. 2026-10-22T13:57:46+08:00"
          },
          "end_time": {
            "type": "string",
            "minLength": 1,
            "description": "RFC3339 time with explicit UTC offset, e.g. 2026-10-22T13:57:46+08:00"
          },
          "as_of": {
            "type": "string",
            "minLength": 1,
            "description": "RFC3339 time with explicit UTC offset, e.g. 2026-10-22T13:57:46+08:00"
          },
          "detail": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary"
          }
        },
        "required": [
          "device_id",
          "start_time",
          "end_time"
        ],
        "additionalProperties": false
